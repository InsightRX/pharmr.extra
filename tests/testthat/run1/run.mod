$SIZES PD=100

$PROBLEM Base linear model with iv input

$INPUT ID TIME DV MDV EVID SS II AMT

$DATA /Users/ronkeizer/git/pharmaai/pharmr.extra/tests/testthat/run1/data.csv IGNORE=@

$SUBROUTINES ADVAN1 TRANS2

$ABBR REPLACE ETA_V=ETA(1)
$ABBR REPLACE ETA_CL=ETA(2)
$PK
TVCL = THETA(1)
TVV  = THETA(2)

CL = TVCL*EXP(ETA_CL)
V = TVV*EXP(ETA_V)

S1 = V

$ERROR
W = 1
IPRED = F
Y = IPRED + W * EPS(1)

$THETA  (0, 15)  ; POP_CL
$THETA  (0, 5)   ; POP_V
$OMEGA  0.25 ; IIV_V
$OMEGA  0.25 ; IIV_CL
$SIGMA  0.5 ; RUV_ADD

$ESTIMATION METHOD=SAEM INTER NBURN=500 NITER=1000 ISAMPLE=2
$COVARIANCE UNCONDITIONAL PRINT=E PRECOND=1

$TABLE
  ID TIME DV EVID MDV IPRED PRED CWRES CIWRES NPDE
  NOAPPEND NOPRINT
  FILE=sdtab


