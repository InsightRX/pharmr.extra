$SIZES PD=100

$PROBLEM Base linear model with oral input

$INPUT ID TIME DV EVID AMT MDV CMT AGE WEIGHT HEIGHT TEMPERATURE ALBUMIN BILIRUBIN CREATININE HEMATOCRIT SEX RACE ETHNIC GROUP ORIGID ENC_TIME
$DATA DUMMYPATH IGNORE=@

$SUBROUTINES ADVAN2 TRANS2

$ABBR REPLACE eta_dummy=ETA(1)
$ABBR REPLACE ETA_CL=ETA(2)
$PK
DUMMYETA = ETA_DUMMY
TVKA = THETA(1)
TVCL = THETA(2)
TVV  = THETA(3)

KA=TVKA
CL = TVCL*EXP(ETA_CL)
V=TVV

S2 = TVV/1000

$ERROR
W = 1
IPRED = F
Y = IPRED + W * EPS(1)

$THETA  (0, 0.5) ; POP_KA
$THETA  (0, 61200.0)  ; POP_CL
$THETA  (0, 153000.0)   ; POP_V
$OMEGA  0 FIX ; DUMMYOMEGA
$OMEGA  0.25 ; IIV_CL
$SIGMA  0.5 ; RUV_ADD

$ESTIMATION METHOD=COND INTER MAXEVAL=2000 PRINT=5 POSTHOC NOABORT
$COVARIANCE UNCONDITIONAL PRINT=E PRECOND=1

$TABLE
  ID
  NOAPPEND NOPRINT
  FILE=patab


$TABLE
  ID TIME DV EVID MDV PRED IPRED CWRES NPDE
  NOAPPEND NOPRINT
  FILE=sdtab


