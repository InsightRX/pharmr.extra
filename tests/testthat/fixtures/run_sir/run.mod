$SIZES PD=100

$PROBLEM Base linear model with oral input

$INPUT ID TIME CMT EVID MDV DV AMT GROUP ORIGID WEIGHT HEIGHT ALBUMIN BILIRUBIN CREATININE HEMATOCRIT ENC_TIME
$DATA /home/rstudio/git/pharmaai/pharmr.extra/1/data.csv IGNORE=@

$SUBROUTINES ADVAN2 TRANS2

$ABBR REPLACE ETA_V=ETA(1)
$ABBR REPLACE ETA_CL=ETA(2)
$PK
TVKA = THETA(1)
TVCL = THETA(2)
TVV  = THETA(3)

KA=TVKA
CL = TVCL*EXP(ETA_CL)
V = TVV*EXP(ETA_V)

S2 = V

$ERROR
W = 1
IPRED = F
Y = IPRED + W * EPS(1)

$THETA  (0, 0.5) ; POP_KA
$THETA  (0, 5.41)  ; POP_CL
$THETA  (0, 153.0)   ; POP_V
$OMEGA  0.04 ; IIV_V
$OMEGA  0.04 ; IIV_CL
$SIGMA  0.5 ; RUV_ADD

$ESTIMATION METHOD=COND INTER MAXEVAL=2000 PRINT=5
$COVARIANCE UNCONDITIONAL PRINT=E PRECOND=1  SIRSAMPLE=500 SIRNITER=10 
$TABLE
  ID TIME DV EVID MDV IPRED PRED CWRES CIWRES NPDE

 NOAPPEND NOPRINT FILE=sdtab


