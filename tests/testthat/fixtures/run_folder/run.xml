<nm:control_stream><![CDATA[
$SIZES PD=100

$PROBLEM Base linear model with oral input

$INPUT ID DV TIME EVID AMT MDV CMT ENC_TIME
$DATA /home/rstudio/git/pharmaai/debug/debug_20261021/20_12_16_2026_01_16_poppk_run/data.csv IGNORE=@

$SUBROUTINES ADVAN2 TRANS2

$ABBR REPLACE ETA_V=ETA(1)
$ABBR REPLACE ETA_CL=ETA(2)
$PK
TVKA = THETA(1)
TVCL = THETA(2)
TVV  = THETA(3)

KA=TVKA
CL = TVCL*EXP(ETA_CL)
V = TVV*EXP(ETA_V)

S2 = V/1000

$ERROR
W = 1
IPRED = F
IF (IPRED.EQ.0) THEN
    IPREDADJ = 2.22500000000000E-16
ELSE
    IPREDADJ = IPRED
END IF
Y = IPRED + EPS(1)*IPREDADJ

$THETA  (0, 0.5) ; POP_KA
$THETA  (0, 6.52)  ; POP_CL
$THETA  (0, 116.0)   ; POP_V
$OMEGA  0.25 ; IIV_V
$OMEGA  0.25 ; IIV_CL
$SIGMA  0.09 ; sigma
$ESTIMATION METHOD=COND INTER MAXEVAL=2000 PRINT=5 POSTHOC NOABORT
$COVARIANCE UNCONDITIONAL PRINT=E PRECOND=1

$TABLE
  ID CL TVKA V
  NOAPPEND NOPRINT
  FILE=patab


$TABLE
  ID TIME DV EVID MDV PRED IPRED CWRES NPDE
  NOAPPEND NOPRINT
  FILE=sdtab


]]></nm:control_stream>
