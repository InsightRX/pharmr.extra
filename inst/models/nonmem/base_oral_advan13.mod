$SIZES PD=100

$PROBLEM Base linear model with oral input

$INPUT ID TIME DV MDV EVID SS II AMT

$DATA nm_data.csv IGNORE=@
  
$SUBROUTINES ADVAN13 TOL=9

$MODEL 
COMP=(ABS DEFDOSE INITIALOFF) 
COMP=(CENTRAL DEFOBS)
NCOMP=2

$ABBR REPLACE ETA_CL=ETA(1)
$PK
TVKA = THETA(1)
TVCL = THETA(2)
TVV  = THETA(3)

KA=TVKA
CL=TVCL*EXP(ETA_CL)
V=TVV

S2 = V
  
$DES
DADT(1) = -KA*A(1)
DADT(2) =  KA*A(1) - (CL/V)*A(2)
  
$ERROR
W = 1
IPRED = F
Y = IPRED + W * EPS(1)
  
$THETA  (0, 0.5) ; POP_KA
$THETA  (0, 15)  ; POP_CL
$THETA  (0, 5)   ; POP_V
$OMEGA  0.3  ; IIV_CL
$SIGMA  0.5 ; RUV_ADD

$EST METHOD=1
$COV UNCOND
  
